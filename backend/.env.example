# ─── Backend environment variables ────────────────────────────────────────────

# OpenAI API key — required for Whisper transcription and GPT summarization
OPENAI_API_KEY=mock

# Port the Express server listens on
PORT=3001

# The frontend origin allowed by CORS (no trailing slash)
FRONTEND_URL=http://localhost:5173

# AWS S3 — audio upload storage
S3_BUCKET=your-bucket-name
S3_REGION=sa-east-1
S3_ACCESS_KEY=AKIA...
S3_SECRET_KEY=...
